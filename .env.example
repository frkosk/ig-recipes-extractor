# Provider: "anthropic" (default) or "openrouter"
LLM_PROVIDER=anthropic

# --- Anthropic (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6   # optional override

# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_HTTP_REFERER=https://github.com/frkosk/ig-recipes-extractor   # optional, for OpenRouter ranking
# OPENROUTER_APP_TITLE=ig-recipes-extractor                                # optional

# Where .md files are written (directory inside your Obsidian vault)
VAULT_RECIPES_DIR=/Users/ferikocurik/Library/Mobile Documents/iCloud~md~obsidian/Documents/Recipies

# --- yt-dlp cookies (optional; IG usually requires login) ---
# Use one of:
# IG_COOKIES_FROM_BROWSER=safari    # or chrome, firefox, edge, brave, opera
# IG_COOKIES_FILE=cookies.txt       # relative path = project root
# IG_COOKIES_FILE=~/Downloads/ig.txt  # ~ is expanded; absolute path also OK

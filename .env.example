# Provider: "anthropic" (default) alebo "openrouter"
LLM_PROVIDER=anthropic

# --- Anthropic (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6   # optional override

# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_HTTP_REFERER=https://github.com/ferikocurik/ig-recipes-extractor   # optional, pre OpenRouter ranking
# OPENROUTER_APP_TITLE=ig-recipes-extractor                                     # optional

# Kam sa zapisujú md súbory (adresár v Obsidian vaulte)
VAULT_RECIPES_DIR=/Users/ferikocurik/Library/Mobile Documents/iCloud~md~obsidian/Documents/Recipies

# --- yt-dlp cookies (voliteľné, ale IG často žiada login) ---
# Použi jedno z:
# IG_COOKIES_FROM_BROWSER=safari    # alebo chrome, firefox, edge, brave, opera
# IG_COOKIES_FILE=cookies.txt       # relatívna cesta = voči project rootu
# IG_COOKIES_FILE=~/Downloads/ig.txt  # ~ expanduje; absolutna cesta tiez OK
